void __fastcall TForm1::BinitClick(TObject *Sender)
{
	I16 Id_card1;
	Id_card1=c9111->Initialisation();                                           //appel de la fonction Initialiser de la class
	if (Id_card1>=0)                                                            //Si l'initialisation est faite
	{
		Edit1->Visible=true;
        Binit->Enabled=false;
		Bquitter->Visible=true;
		B_0V->Visible=true;
		B_5V->Visible=true;
		B_10V->Visible=true;
		Button1->Visible=true;
		Shape1->Visible=true;
		MessageBox(NULL,"Connexion réussi","REUSSI",MB_OK);
	}
	else
	{
		MessageBox(NULL,"Erreur de connexion","ATTENTION",MB_ICONSTOP);
    }

}
//---------------------------------------------------------------------------




void __fastcall TForm1::BquitterClick(TObject *Sender)
{
    c9111->active0volt();
	c9111->Quitter();
	Edit1->Visible=false;
	Binit->Enabled=true;
	Bquitter->Visible=false;
	B_0V->Visible=false;
	B_5V->Visible=false;
	B_10V->Visible=false;
	Button1->Visible=false;
    Shape1->Visible=false;
	Close();

}
