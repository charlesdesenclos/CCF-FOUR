void __fastcall TForm1::Button1Click(TObject *Sender)
{
	/*char *adress;
	char *id;
	char *mdp;
	char *table;

	etat=bdd->connexion(adress,id,mdp,table);   //verification des données pour la connexion
    */
	etat=bdd->connexion("192.168.64.4","vm","root","four");
	if (etat==true) {
		Shape1->Brush->Color=clGreen;
		Deconnexion->Visible=true;
		Button1->Visible=false;
		Timer1->Enabled=true;
        F64 Tension_lu = 0;
		F64 temperature = 0;
		Tension_lu = c9111->afficher_tension();
		temperature = ((Tension_lu*100)/10);
		Edit1->Text=temperature;
		bdd->envoi(temperature);
	}
	else{
		Shape1->Brush->Color=clRed;
		Deconnexion->Visible=false;
		Button1->Visible=true;
        Timer1->Enabled=false;
	}
}
//---------------------------------------------------------------------------

void __fastcall TForm1::DeconnexionClick(TObject *Sender)
{
    bool reponse;

	reponse=bdd->deconnexion();        //deconnexion de la bdd

	if (reponse == true) {
		Shape1->Brush->Color=clRed;
		Button1->Visible=true;
		Deconnexion->Visible=false;
		etat=NULL;
        Timer1->Enabled=false;
	}
	else{
		Shape1->Brush->Color=clGreen;
	}
}
//---------------------------------------------------------------------------

void __fastcall TForm1::Timer1Timer(TObject *Sender)
{
	F64 Tension_lu = 0;
	F64 temperature = 0;
	Tension_lu = c9111->afficher_tension();
	temperature = ((Tension_lu*100)/10);
	Edit1->Text=temperature;
	bdd->envoi(temperature);
}
